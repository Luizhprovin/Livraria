{
  "name": "livraria",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de livros com Node.js, Express, Sequelize e PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:undo": "sequelize-cli db:migrate:undo",
    "check:syntax": "node --check index.js && node --check controllers/LivroController.js && node --check routes/livros.routes.js && node --check config/config.js && node --check docs/openapi.js",
    "check": "npm run check:syntax && npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20.18",
    "npm": ">=10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  }
}
